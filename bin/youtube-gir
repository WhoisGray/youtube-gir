#!/usr/bin/env bash

set -o pipefail

readonly APP_NAME="youtube-gir"
readonly APP_VERSION="1.0.0"
readonly REPOSITORY="WhoisGray/youtube-gir"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  readonly C_RESET=$'\033[0m'
  readonly C_BOLD=$'\033[1m'
  readonly C_BLUE=$'\033[34m'
  readonly C_GREEN=$'\033[32m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_RED=$'\033[31m'
else
  readonly C_RESET="" C_BOLD="" C_BLUE="" C_GREEN="" C_YELLOW="" C_RED=""
fi

info() { printf '%sℹ%s  %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s✅%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s⚠️%s  %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die() { printf '%s❌%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/youtube-gir"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/youtube-gir"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/youtube-gir"
CONFIG_FILE="$CONFIG_HOME/config"
RUN_TEMP_DIR=""

cleanup_run_temp() {
  local run_root="$CACHE_HOME/runs"
  if [[ -n "$RUN_TEMP_DIR" && "$RUN_TEMP_DIR" == "$run_root"/run.* && -d "$RUN_TEMP_DIR" ]]; then
    rm -rf "$RUN_TEMP_DIR"
  fi
  RUN_TEMP_DIR=""
  return 0
}

trap cleanup_run_temp EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

default_media="video"
default_quality="excellent"
audio_dir=""
video_dir=""
cookies_browser="chrome"
use_cookies="true"
sponsorblock="true"
use_archive="false"
archive_file="$DATA_HOME/archive.txt"
youtube_player_client="mweb"
embed_thumbnail="true"
embed_metadata="true"

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

expand_path() {
  case "$1" in
    "~") printf '%s' "$HOME" ;;
    \~/*) printf '%s/%s' "$HOME" "${1#~/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

valid_bool() { [[ "$1" == "true" || "$1" == "false" ]]; }

set_config_value() {
  local key="$1" value="$2"
  case "$key" in
    default_media) [[ "$value" == "audio" || "$value" == "video" ]] && default_media="$value" ;;
    default_quality) normalize_quality "$value" >/dev/null && default_quality="$(normalize_quality "$value")" ;;
    audio_dir) audio_dir="$value" ;;
    video_dir) video_dir="$value" ;;
    cookies_browser) cookies_browser="$value" ;;
    use_cookies) valid_bool "$value" && use_cookies="$value" ;;
    sponsorblock) valid_bool "$value" && sponsorblock="$value" ;;
    use_archive) valid_bool "$value" && use_archive="$value" ;;
    archive_file) archive_file="$value" ;;
    youtube_player_client) youtube_player_client="$value" ;;
    embed_thumbnail) valid_bool "$value" && embed_thumbnail="$value" ;;
    embed_metadata) valid_bool "$value" && embed_metadata="$value" ;;
    *) warn "Ignoring unknown configuration key: $key" ;;
  esac
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "$line")"
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    key="$(trim "${line%%=*}")"
    value="$(trim "${line#*=}")"
    set_config_value "$key" "$value"
  done < "$CONFIG_FILE"
}

save_config() {
  mkdir -p "$CONFIG_HOME" "$CACHE_HOME" "$DATA_HOME" || die "Could not create configuration directories."
  local temporary="$CONFIG_FILE.tmp.$$"
  umask 077
  {
    printf '# youtube-gir configuration — values are plain text (not shell code)\n'
    printf 'default_media=%s\n' "$default_media"
    printf 'default_quality=%s\n' "$default_quality"
    printf 'audio_dir=%s\n' "$audio_dir"
    printf 'video_dir=%s\n' "$video_dir"
    printf 'cookies_browser=%s\n' "$cookies_browser"
    printf 'use_cookies=%s\n' "$use_cookies"
    printf 'sponsorblock=%s\n' "$sponsorblock"
    printf 'use_archive=%s\n' "$use_archive"
    printf 'archive_file=%s\n' "$archive_file"
    printf 'youtube_player_client=%s\n' "$youtube_player_client"
    printf 'embed_thumbnail=%s\n' "$embed_thumbnail"
    printf 'embed_metadata=%s\n' "$embed_metadata"
  } > "$temporary" || die "Could not write the configuration file."
  mv "$temporary" "$CONFIG_FILE" || die "Could not save the configuration file."
  ok "Configuration saved to $CONFIG_FILE"
}

normalize_quality() {
  local lowered
  lowered="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$lowered" in
    excellent|best) printf 'excellent' ;;
    normal) printf 'normal' ;;
    good) printf 'good' ;;
    low) printf 'low' ;;
    *) return 1 ;;
  esac
}

audio_bitrate() {
  case "$1" in
    excellent) printf '192k' ;;
    normal) printf '160k' ;;
    good) printf '128k' ;;
    low) printf '96k' ;;
  esac
}

video_height() {
  case "$1" in
    excellent) printf '1080' ;;
    normal) printf '720' ;;
    good) printf '480' ;;
    low) printf '360' ;;
  esac
}

print_version() { printf '%s %s\n' "$APP_NAME" "$APP_VERSION"; }

usage() {
  cat <<'EOF'
🎬 youtube-gir — fast and interactive yt-dlp frontend

Usage:
  youtube-gir LINK                         Quick download using excellent quality
  youtube-git LINK                         Compatibility alias
  youtube-gir                              Start interactive mode
  youtube-gir [OPTIONS] LINK [LINK...]

Download options:
  -a, --audio                Audio only (M4A/AAC)
  -v, --video                Video and audio (MP4)
  -q, --quality LEVEL        excellent | normal | good | low
  -o, --output DIR           Output directory for this run
      --fast                 Fast mode without thumbnail or chapters
      --sponsorblock         Remove sponsor and self-promotion segments
      --no-sponsorblock      Disable SponsorBlock
      --archive              Skip previously downloaded items
      --archive-file FILE    Enable archive using a custom file
      --playlist             Allow playlist/channel downloads
      --no-playlist          Download only one video (default)
      --cookies BROWSER      Cookie browser, such as chrome or firefox
      --no-cookies           Run without browser cookies
      --verbose              Show full yt-dlp diagnostic output
      --dry-run              Print the final command without downloading

Management:
      config                 Open interactive configuration
      doctor                 Check dependencies and paths
      check-update           Check youtube-gir and yt-dlp versions
      update                 Update youtube-gir and yt-dlp
      update-core            Update only yt-dlp
  -h, --help                 Show this help
  -V, --version              Show the version

Examples:
  youtube-gir --audio -q good 'https://youtu.be/VIDEO_ID'
  youtube-gir --video --sponsorblock -o "$HOME/Videos" LINK
  youtube-gir --playlist --archive LINK
EOF
}

read_default() {
  local prompt="$1" fallback="$2" answer
  if [[ ! -r /dev/tty ]]; then
    printf '%s' "$fallback"
    return
  fi
  printf '%s' "$prompt" > /dev/tty
  IFS= read -r answer < /dev/tty || answer=""
  printf '%s' "${answer:-$fallback}"
}

choose_media() {
  local answer
  printf '\n%sOutput type%s\n  1) 🎬 Video and audio\n  2) 🎵 Audio only\n' "$C_BOLD" "$C_RESET" > /dev/tty
  answer="$(read_default 'Select [1]: ' '1')"
  case "$answer" in 2|audio) printf 'audio' ;; *) printf 'video' ;; esac
}

choose_quality() {
  local answer
  printf '\n%sQuality%s\n  1) ✨ Excellent\n  2) 🚀 Normal\n  3) 👍 Good\n  4) 📦 Low\n' "$C_BOLD" "$C_RESET" > /dev/tty
  answer="$(read_default 'Select [1]: ' '1')"
  case "$answer" in 2|normal) printf 'normal' ;; 3|good) printf 'good' ;; 4|low) printf 'low' ;; *) printf 'excellent' ;; esac
}

interactive_download() {
  [[ -r /dev/tty ]] || die "Provide a URL when running without an interactive terminal."
  printf '%s🎬 youtube-gir%s — new download\n' "$C_BOLD" "$C_RESET"
  local url media quality playlist_answer
  url="$(read_default '🔗 URL: ' '')"
  [[ -n "$url" ]] || die "The URL cannot be empty."
  media="$(choose_media)"
  quality="$(choose_quality)"
  playlist_answer="$(read_default 'Download the complete playlist? [y/N]: ' 'n')"
  CLI_MEDIA="$media"
  CLI_QUALITY="$quality"
  [[ "$playlist_answer" =~ ^[Yy]$ ]] && CLI_PLAYLIST="true"
  URLS=("$url")
}

interactive_config() {
  [[ -r /dev/tty ]] || die "Interactive configuration requires a terminal."
  printf '%s⚙️  youtube-gir settings%s\n' "$C_BOLD" "$C_RESET"
  printf 'Press Enter to keep the current value. An empty path uses the current directory.\n\n'
  local value
  value="$(read_default "Default media type (video/audio) [$default_media]: " "$default_media")"
  [[ "$value" == "video" || "$value" == "audio" ]] && default_media="$value"
  value="$(read_default "Default quality (excellent/normal/good/low) [$default_quality]: " "$default_quality")"
  if normalize_quality "$value" >/dev/null; then default_quality="$(normalize_quality "$value")"; fi
  audio_dir="$(read_default "Audio directory [${audio_dir:-current directory}] (use - to clear): " "$audio_dir")"
  video_dir="$(read_default "Video directory [${video_dir:-current directory}] (use - to clear): " "$video_dir")"
  [[ "$audio_dir" == "-" ]] && audio_dir=""
  [[ "$video_dir" == "-" ]] && video_dir=""
  cookies_browser="$(read_default "Cookie browser [$cookies_browser]: " "$cookies_browser")"
  value="$(read_default "Use browser cookies? (true/false) [$use_cookies]: " "$use_cookies")"
  valid_bool "$value" && use_cookies="$value"
  value="$(read_default "Enable SponsorBlock by default? (true/false) [$sponsorblock]: " "$sponsorblock")"
  valid_bool "$value" && sponsorblock="$value"
  value="$(read_default "Enable the download archive by default? (true/false) [$use_archive]: " "$use_archive")"
  valid_bool "$value" && use_archive="$value"
  archive_file="$(read_default "Archive file [$archive_file]: " "$archive_file")"
  save_config
}

find_ytdlp() {
  if [[ -n "${YOUTUBE_GIR_YTDLP:-}" && -x "$YOUTUBE_GIR_YTDLP" ]]; then
    printf '%s' "$YOUTUBE_GIR_YTDLP"
  elif [[ -x "$HOME/.local/bin/yt-dlp" ]]; then
    printf '%s' "$HOME/.local/bin/yt-dlp"
  elif command -v yt-dlp >/dev/null 2>&1; then
    command -v yt-dlp
  else
    return 1
  fi
}

doctor() {
  local failed=0 command_name version_line executable
  printf '%s🩺 System check%s\n' "$C_BOLD" "$C_RESET"
  for command_name in brew node deno yt-dlp ffmpeg curl; do
    executable="$(command -v "$command_name" 2>/dev/null || true)"
    if [[ "$command_name" == "yt-dlp" ]]; then executable="$(find_ytdlp || true)"; fi
    if [[ -n "$executable" ]]; then
      version_line="$("$executable" --version 2>/dev/null | head -n 1)"
      ok "$command_name — $version_line"
    else
      warn "$command_name was not found."
      failed=1
    fi
  done
  info "Configuration: $CONFIG_FILE"
  info "Cache: $CACHE_HOME"
  if [[ "$failed" -eq 0 ]]; then ok "The system is ready."; else return 1; fi
}

github_latest_tag() {
  local repository="$1"
  curl -fsSL --connect-timeout 10 --max-time 25 \
    -H 'Accept: application/vnd.github+json' \
    "https://api.github.com/repos/$repository/releases/latest" \
    2>/dev/null \
    | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    | head -n 1
}

version_without_v() { printf '%s' "${1#v}"; }

check_updates() {
  command -v curl >/dev/null 2>&1 || die "curl is not installed."
  local app_latest yt_current yt_latest yt_bin
  info "Checking GitHub releases…"
  app_latest="$(github_latest_tag "$REPOSITORY" || true)"
  if [[ -z "$app_latest" ]]; then
    warn "No public youtube-gir release was found, or GitHub is unavailable."
  elif [[ "$(version_without_v "$app_latest")" == "$APP_VERSION" ]]; then
    ok "youtube-gir is up to date ($APP_VERSION)."
  else
    info "youtube-gir: installed $APP_VERSION — latest $app_latest"
  fi

  yt_bin="$(find_ytdlp || true)"
  if [[ -n "$yt_bin" ]]; then yt_current="$("$yt_bin" --version 2>/dev/null || true)"; else yt_current=""; fi
  yt_latest="$(github_latest_tag 'yt-dlp/yt-dlp' || true)"
  if [[ -z "$yt_current" ]]; then
    warn "yt-dlp is not installed."
  elif [[ "$(version_without_v "$yt_latest")" == "$(version_without_v "$yt_current")" ]]; then
    ok "yt-dlp is up to date ($yt_current)."
  elif [[ -n "$yt_latest" ]]; then
    info "yt-dlp: installed $yt_current — latest $yt_latest"
  else
    warn "Could not check the latest yt-dlp version."
  fi
}

update_core() {
  local yt_bin
  yt_bin="$(find_ytdlp)" || die "yt-dlp is not installed; run install.sh first."
  info "Updating yt-dlp from the stable channel…"
  if "$yt_bin" --update-to stable@latest; then
    ok "yt-dlp was updated successfully."
  else
    die "The yt-dlp update failed. For a Homebrew installation, run: brew upgrade yt-dlp"
  fi
}

self_update() {
  if ! command -v curl >/dev/null 2>&1; then
    warn "curl is not installed; skipping the application update."
    return 1
  fi
  local latest temp_dir archive installer
  latest="$(github_latest_tag "$REPOSITORY" || true)"
  if [[ -z "$latest" ]]; then
    warn "No GitHub release was found for $REPOSITORY; skipping the application update."
    return 1
  fi
  if [[ "$(version_without_v "$latest")" == "$APP_VERSION" ]]; then
    ok "youtube-gir is already up to date ($APP_VERSION)."
    return
  fi
  temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/youtube-gir.XXXXXX")" || die "Could not create a temporary directory."
  archive="$temp_dir/release.tar.gz"
  info "Downloading youtube-gir $latest from GitHub…"
  if ! curl -fL --retry 3 -o "$archive" "https://github.com/$REPOSITORY/archive/refs/tags/$latest.tar.gz"; then
    warn "Could not download the application update."
    rm -rf "$temp_dir"
    return 1
  fi
  if ! tar -xzf "$archive" -C "$temp_dir"; then
    warn "Could not extract the application update."
    rm -rf "$temp_dir"
    return 1
  fi
  installer="$(find "$temp_dir" -mindepth 2 -maxdepth 2 -name install.sh -type f | head -n 1)"
  if [[ -z "$installer" ]]; then
    warn "install.sh was not found in the release."
    rm -rf "$temp_dir"
    return 1
  fi
  if ! bash "$installer" --no-deps; then
    warn "Could not install the application update."
    rm -rf "$temp_dir"
    return 1
  fi
  rm -rf "$temp_dir"
  ok "youtube-gir was updated to $latest."
}

update_all() {
  self_update || warn "Continuing with the independent yt-dlp update…"
  update_core
}

build_download_args() {
  local media="$1" quality="$2" destination="$3" fast="$4" playlist="$5" temporary_dir="$6"
  local bitrate height archive_path
  DOWNLOAD_ARGS=(
    --newline
    --progress
    --progress-template 'download:📥 %(progress._percent_str)s | %(progress._speed_str)s | ETA %(progress._eta_str)s'
    --retries 10
    --fragment-retries 10
    --file-access-retries 3
    --cache-dir "$CACHE_HOME/yt-dlp"
    --js-runtimes deno
    --paths "home:$destination"
    --paths "temp:$temporary_dir"
    -o '%(title)s [%(id)s].%(ext)s'
  )

  if [[ "$media" == "audio" ]]; then
    bitrate="$(audio_bitrate "$quality")"
    DOWNLOAD_ARGS+=(
      -f 'bestaudio[ext=m4a]/bestaudio/best'
      --extract-audio
      --audio-format m4a
      --postprocessor-args "ExtractAudio+ffmpeg:-c:a aac -b:a $bitrate"
      --parse-metadata '%(channel)s:%(meta_artist)s'
    )
  else
    height="$(video_height "$quality")"
    DOWNLOAD_ARGS+=(
      -f "bestvideo[vcodec^=avc1][height<=$height]+bestaudio[ext=m4a]/bestvideo[vcodec^=avc1][height<=$height]+bestaudio/bestvideo[height<=$height]+bestaudio/best[height<=$height]/best"
      --merge-output-format mp4
      --postprocessor-args 'Merger+ffmpeg:-c:v copy -c:a aac -b:a 192k -ar 44100 -movflags +faststart'
    )
  fi

  if [[ "$fast" != "true" ]]; then
    [[ "$embed_thumbnail" == "true" ]] && DOWNLOAD_ARGS+=(--embed-thumbnail --convert-thumbnails jpg)
    [[ "$embed_metadata" == "true" ]] && DOWNLOAD_ARGS+=(--embed-metadata --embed-chapters)
  else
    DOWNLOAD_ARGS+=(--concurrent-fragments 4)
    [[ "$embed_metadata" == "true" ]] && DOWNLOAD_ARGS+=(--embed-metadata)
  fi
  [[ "$use_cookies" == "true" ]] && DOWNLOAD_ARGS+=(--cookies-from-browser "$cookies_browser")
  [[ -n "$youtube_player_client" ]] && DOWNLOAD_ARGS+=(--extractor-args "youtube:player_client=$youtube_player_client")
  [[ "$sponsorblock" == "true" ]] && DOWNLOAD_ARGS+=(--sponsorblock-remove 'sponsor,selfpromo')
  if [[ "$use_archive" == "true" ]]; then
    archive_path="$(expand_path "$archive_file")"
    mkdir -p "$(dirname "$archive_path")" || die "Could not create the archive directory."
    DOWNLOAD_ARGS+=(--download-archive "$archive_path")
  fi
  if [[ "$playlist" == "true" ]]; then DOWNLOAD_ARGS+=(--yes-playlist); else DOWNLOAD_ARGS+=(--no-playlist); fi
}

print_command() {
  local item
  printf '%q ' "$1"
  shift
  for item in "$@"; do printf '%q ' "$item"; done
  printf '\n'
}

run_download() {
  local media="$CLI_MEDIA" quality="$CLI_QUALITY" output_dir yt_bin run_root
  sponsorblock="$CLI_SPONSOR"
  use_archive="$CLI_ARCHIVE"
  use_cookies="$CLI_COOKIES"
  cookies_browser="$CLI_BROWSER"
  output_dir="$CLI_OUTPUT"
  if [[ -z "$output_dir" ]]; then
    if [[ "$media" == "audio" ]]; then output_dir="$audio_dir"; else output_dir="$video_dir"; fi
  fi
  output_dir="$(expand_path "${output_dir:-$PWD}")"
  mkdir -p "$output_dir" || die "Could not create the output directory: $output_dir"
  mkdir -p "$CACHE_HOME/yt-dlp" || die "Could not create the cache directory: $CACHE_HOME"
  run_root="$CACHE_HOME/runs"
  mkdir -p "$run_root" || die "Could not create the temporary download directory: $run_root"
  RUN_TEMP_DIR="$(mktemp -d "$run_root/run.XXXXXX")" || die "Could not create a temporary download directory."
  build_download_args "$media" "$quality" "$output_dir" "$CLI_FAST" "$CLI_PLAYLIST" "$RUN_TEMP_DIR"
  [[ "$CLI_VERBOSE" == "true" ]] && DOWNLOAD_ARGS+=(--verbose)
  yt_bin="$(find_ytdlp)" || die "yt-dlp was not found. Run install.sh or fix your PATH."

  info "Type: $media | Quality: $quality | Output: $output_dir"
  [[ "$sponsorblock" == "true" ]] && info "SponsorBlock is enabled."
  [[ "$use_archive" == "true" ]] && info "Download archive: $(expand_path "$archive_file")"
  if [[ "$CLI_DRY_RUN" == "true" ]]; then
    print_command "$yt_bin" "${DOWNLOAD_ARGS[@]}" "${URLS[@]}"
    return
  fi
  printf '\n'
  local status
  "$yt_bin" "${DOWNLOAD_ARGS[@]}" "${URLS[@]}"
  status=$?
  if [[ "$status" -eq 0 ]]; then
    cleanup_run_temp
    ok "Download completed successfully: $output_dir"
  else
    printf '\n'
    die "yt-dlp exited with status $status. The complete error output is shown above."
  fi
}

main() {
  load_config
  CLI_MEDIA="$default_media"
  CLI_QUALITY="$default_quality"
  CLI_OUTPUT=""
  CLI_FAST="false"
  CLI_SPONSOR="$sponsorblock"
  CLI_ARCHIVE="$use_archive"
  CLI_COOKIES="$use_cookies"
  CLI_BROWSER="$cookies_browser"
  CLI_PLAYLIST="false"
  CLI_DRY_RUN="false"
  CLI_VERBOSE="false"
  URLS=()

  if [[ $# -eq 0 ]]; then
    interactive_download
    run_download
    return
  fi

  case "$1" in
    config) shift; interactive_config; return ;;
    doctor) shift; doctor; return ;;
    check-update) shift; check_updates; return ;;
    update-core) shift; update_core; return ;;
    update) shift; update_all; return ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a|--audio) CLI_MEDIA="audio" ;;
      -v|--video) CLI_MEDIA="video" ;;
      -q|--quality)
        [[ $# -ge 2 ]] || die "$1 requires a value."
        CLI_QUALITY="$(normalize_quality "$2")" || die "Invalid quality: $2"
        shift
        ;;
      -o|--output)
        [[ $# -ge 2 ]] || die "$1 requires a directory."
        CLI_OUTPUT="$2"
        shift
        ;;
      --fast) CLI_FAST="true" ;;
      --sponsorblock) CLI_SPONSOR="true" ;;
      --no-sponsorblock) CLI_SPONSOR="false" ;;
      --archive) CLI_ARCHIVE="true" ;;
      --archive-file)
        [[ $# -ge 2 ]] || die "$1 requires a file."
        CLI_ARCHIVE="true"; archive_file="$2"; shift
        ;;
      --playlist) CLI_PLAYLIST="true" ;;
      --no-playlist) CLI_PLAYLIST="false" ;;
      --cookies)
        [[ $# -ge 2 ]] || die "$1 requires a browser name."
        CLI_COOKIES="true"; CLI_BROWSER="$2"; shift
        ;;
      --no-cookies) CLI_COOKIES="false" ;;
      --verbose) CLI_VERBOSE="true" ;;
      --dry-run) CLI_DRY_RUN="true" ;;
      -h|--help) usage; return ;;
      -V|--version) print_version; return ;;
      --) shift; while [[ $# -gt 0 ]]; do URLS+=("$1"); shift; done; break ;;
      -*) die "Unknown option: $1 (see: youtube-gir --help)" ;;
      *) URLS+=("$1") ;;
    esac
    shift
  done

  [[ ${#URLS[@]} -gt 0 ]] || die "No URL was provided. Run youtube-gir without arguments for interactive mode."
  run_download
}

main "$@"
